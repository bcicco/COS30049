# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
# Virtual environments
.venv
.env
# Data (corpora, checkpoints, HF cache) never committed.
# **IMPORTANT** : ml/reports/ and ml/manifests/ are deliverables and live OUTSIDE data/ so
# they stay tracked. Do not add a global *.jsonl rule -- it would swallow
# ml/tests/fixtures/.
**/data/
**/reports
**.json
*.html
*.drawio
# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
# ML artifacts
*.parquet
*.pt
*.safetensors
checkpoints/
.ipynb_checkpoints/
# Web app. The *.json / *.html rules above are for ML artifacts; the
# frontend needs its package manifests, lint config and index.html tracked.
!frontend/**/*.json
!frontend/**/*.html
node_modules/
# The served model is ~70 KB and the backend can't start without it.
!backend/models/**/*.pt
!backend/models/**/*.json
