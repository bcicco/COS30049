
HF_TOKEN=

# Project-local HF cache. 
# ** IMPORTANT ** Keeps ~12 GB of corpora out of the shared user cache.
HF_HOME=./data/hf

# constant warning is annoying as, not actually needed but keeps me sane
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# formats console output
PYTHONUTF8=1

# avoid thread oversubscription when segmenting in a multiprocessing Pool, trick learnt from BERT days
TOKENIZERS_PARALLELISM=false

# Override the data root (defaults to ml/data).
AIVHUMAN_DATA_ROOT=

# Segmentation worker count (defaults to cpu_count() - 2).
AIVHUMAN_WORKERS=
