# Copy to .env and edit. Every setting is optional.
AIVHUMAN_DEVICE=cpu
# AIVHUMAN_MODEL_DIR=models/p5-adv
# AIVHUMAN_CORS_ORIGINS=["http://localhost:5173"]
# AIVHUMAN_MAX_BODY_BYTES=2000000

# Accounts. The default database is backend/data/app.db (gitignored).
# AIVHUMAN_DATABASE_URL=sqlite:///data/app.db
# AIVHUMAN_SESSION_DAYS=7
# Set to true once served over https, so the session cookie is never sent in clear.
# AIVHUMAN_COOKIE_SECURE=false

# Denial of service: jobs scored at once, how many may wait, and for how long.
# AIVHUMAN_SCORE_WORKERS=1
# AIVHUMAN_SCORE_QUEUE=4
# AIVHUMAN_SCORE_WAIT_SECONDS=30
